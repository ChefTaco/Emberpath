                  },
                  "required": [
                    "ok"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Exact receipt; Cache-Control: no-store"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "router:keys:write and recent interactive authentication required"
          },
          "409": {
            "description": "Operation owner, policy or resource conflict"
          },
          "410": {
            "description": "Receipt expired or acknowledged; no automatic rotation"
          }
        },
        "security": [
          {
            "resourceBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "summary": "Acknowledge an owned credential receipt"
      }
    },
