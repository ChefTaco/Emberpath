    "securitySchemes": {
      "adminSession": {
        "in": "cookie",
        "name": "hive_router_admin",
        "type": "apiKey"
      },
      "resourceBearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Model routing and administration baseline. Complete request/response schema coverage remains pending.",
